<?xml version="1.0" encoding="utf-8"?>
<!--
  Files the app may hand to other apps. The viewer's documents are cached copies
  under the app cache, so exposing the cache (and files) directory lets Share
  send the open PDF through the FileProvider.
-->
<paths>
    <cache-path name="cache" path="." />
    <files-path name="files" path="." />
</paths>
