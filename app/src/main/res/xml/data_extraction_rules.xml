<?xml version="1.0" encoding="utf-8"?>
<!--
  Task T50: neither cloud backup nor device-to-device transfer may carry the
  search index away from this device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="pdfpaper-search-index.db" />
        <exclude domain="database" path="pdfpaper-search-index.db-wal" />
        <exclude domain="database" path="pdfpaper-search-index.db-shm" />
        <exclude domain="database" path="pdfpaper-search-index.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="pdfpaper-search-index.db" />
        <exclude domain="database" path="pdfpaper-search-index.db-wal" />
        <exclude domain="database" path="pdfpaper-search-index.db-shm" />
        <exclude domain="database" path="pdfpaper-search-index.db-journal" />
    </device-transfer>
</data-extraction-rules>
