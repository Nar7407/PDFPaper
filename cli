#!/usr/bin/env sh
set -eu

usage() {
    echo "Usage: cli fontinfo <file.pdf> --page <n>" >&2
    echo "       cli add-text|add-image|list-images|move-image|replace-image|delete-image ..." >&2
    echo "       cli convert pdf-to-pptx <in.pdf> --out <out.pptx> [--fidelity]" >&2
    echo "       cli convert pdf-to-docx <in.pdf> --out <out.docx> [--mode flow|exact]" >&2
    echo "       cli convert docx-to-pdf <in.docx> --out <out.pdf>" >&2
    echo "       cli convert pptx-to-pdf <in.pptx> --out <out.pdf>" >&2
    echo "       cli create blank --size A4 --out <out.pdf>" >&2
    echo "       cli images-to-pdf <image>... --out <out.pdf> [--fit fit|fill|original]" >&2
    echo "       cli text-to-pdf <in.txt> --out <out.pdf>" >&2
    echo "       cli comments list|add|reply|set-status ..." >&2
    echo "       cli stamp list|add ..." >&2
    echo "       cli sign-visual <in.pdf> --page N --image|--typed|--strokes ... --x X --y Y --width W --out <out.pdf>" >&2
    echo "       cli sign <in.pdf> --p12 <key.p12> --pass-env <ENV> [--rect l,b,r,t] --out <out.pdf>" >&2
    echo "       cli signatures verify <file.pdf> [--truststore <pem-or-keystore>] [--password <pw>]" >&2
    echo "       cli ocr <file.pdf> [--lang eng+hin] [--out <out.pdf>] [--pages 1,3-5] [--text <words>]" >&2
    echo "       cli compress <in.pdf> --preset <light|balanced|strong> --out <out.pdf> [--dpi <n>] [--quality <n>] [--grayscale]" >&2
    echo "       cli mark watermark|number-pages|bates <in.pdf> --out <out.pdf> [...]" >&2
    echo "       cli export-images <in.pdf> --out-dir <dir> [--dpi 150] [--pages 1-5] [--format png|jpg|webp]" >&2
    echo "       cli extract-images <in.pdf> --out-dir <dir> [--min-size 32] [--list]" >&2
    echo "       cli crop <in.pdf> --margins 10,10,10,10 --pages all --out <out.pdf> [--remove-hidden]" >&2
    echo "       cli search-regex <in.pdf> \"<pattern>\" --out <matches.csv> [--case-sensitive] [--lines] [--pages 1,3-5]" >&2
    exit 2
}

root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ "$#" -eq 0 ]; then
    usage
fi

case "$1" in
    fontinfo)
        if [ "$#" -ne 4 ] || [ "$3" != "--page" ]; then
            usage
        fi
        exec "$root/gradlew" -q :engine:fontinfo -PfontinfoFile="$2" -PfontinfoPage="$4"
        ;;
    add-text|add-image|list-images|move-image|replace-image|delete-image)
        exec "$root/gradlew" -q :engine:pdfedit --args="$*"
        ;;
    convert)
        exec "$root/gradlew" -q :convert:convert --args="$*"
        ;;
    create|images-to-pdf|text-to-pdf)
        exec "$root/gradlew" -q :engine:create --args="$*"
        ;;
    comments)
        exec "$root/gradlew" -q :engine:comments --args="$*"
        ;;
    stamp)
        exec "$root/gradlew" -q :engine:stamp --args="$*"
        ;;
    sign-visual)
        exec "$root/gradlew" -q :engine:signvisual --args="$*"
        ;;
    sign)
        exec "$root/gradlew" -q :signatures:sign --args="$*"
        ;;
    signatures)
        exec "$root/gradlew" -q :signatures:verify --args="$*"
        ;;
    ocr)
        exec "$root/gradlew" -q :engine:ocr --args="$*"
        ;;
    compress)
        exec "$root/gradlew" -q :render-jvm:compress --args="$*"
        ;;
    mark)
        exec "$root/gradlew" -q :engine:mark --args="$*"
        ;;
    export-images|extract-images)
        exec "$root/gradlew" -q :render-jvm:export --args="$*"
        ;;
    crop)
        exec "$root/gradlew" -q :render-jvm:crop --args="$*"
        ;;
    search-regex)
        exec "$root/gradlew" -q :engine:search-regex --args="$*"
        ;;
    *)
        usage
        ;;
esac
